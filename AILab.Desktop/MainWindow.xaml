<Window x:Class="AILab.Desktop.MainWindow"
        PreviewKeyDown="Window_PreviewKeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Lab - Enemy AI Sandbox"
        Height="700"
        Width="1000"
        MinHeight="700"
        MinWidth="1000"
        Background="#171C26"
        Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="AI LAB"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Enemy AI Simulation Sandbox"
                       FontSize="14"
                       Foreground="#AAB4C5"/>
        </StackPanel>

        <!-- Simulation arena -->
        <Border Grid.Row="1"
                Background="#222B3A"
                CornerRadius="12"
                Padding="10">

            <Canvas x:Name="SimulationCanvas"
                     Width="760"
                     Height="480"
                     Background="#263448"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     ClipToBounds="True"
                     MouseLeftButtonDown="SimulationCanvas_MouseLeftButtonDown"/>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PauseButton"
                    Grid.Column="0"
                    Content="Pause"
                    Width="110"
                    Height="38"
                    Click="PauseButton_Click"/>

            <StackPanel Grid.Column="1"
                        Margin="25,0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="SpeedLabel"
                           Text="Simulation Speed: 1.0x"
                           Margin="0,0,0,5"/>

                <Slider x:Name="SpeedSlider"
                        Minimum="0.25"
                        Maximum="3"
                        Value="1"
                        TickFrequency="0.25"
                        IsSnapToTickEnabled="True"
                        ValueChanged="SpeedSlider_ValueChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        x:Name="AgentStatusPanel"
                        MinWidth="170"/>
        </Grid>
    </Grid>
</Window>
